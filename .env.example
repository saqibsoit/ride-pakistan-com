APP_NAME="Ride Pakistan"
APP_ENV=local
APP_KEY=
# Key rotation (docs/SECURITY.md): move the old key here, comma separated.
APP_PREVIOUS_KEYS=
# Never true in production or staging: it shows stack traces and config.
# Turn it on locally only while debugging.
APP_DEBUG=false
APP_URL=https://ride-pakistan-com.test

# Dates are stored in UTC; this is only used when displaying them.
APP_DISPLAY_TIMEZONE=Asia/Karachi

# Filament admin panel path. Use a long, unguessable value in production.
ADMIN_PATH=change-me-admin-path

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB (InnoDB, utf8mb4, strict mode), matching Hostinger. DB_CONNECTION=mysql also works for MySQL 8.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ride_pakistan
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Production: SESSION_ENCRYPT=true. Cookies are Secure by default when APP_ENV=production
# (override with SESSION_SECURE_COOKIE), HttpOnly and SameSite=Lax.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log locally and in tests; resend in staging and production (docs/DEPLOY.md).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bookings@mail.ride-pakistan.com"
MAIL_FROM_NAME="Ride Pakistan"
MAIL_REPLY_TO_ADDRESS="hello@ride-pakistan.com"
MAIL_REPLY_TO_NAME="Ride Pakistan"
# Resend API key: a server secret, set only in each server's shared/.env.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe (Destination Pakistan account). Test keys locally; never commit real values.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_STATEMENT_DESCRIPTOR_SUFFIX="RIDE PAKISTAN"

# WhatsApp notifications (GT360, not connected yet): the channel only logs when on.
WHATSAPP_ENABLED=false

# Cloudflare Turnstile (bot check on /login and the lead forms). /login: empty secret
# passes outside production, fails closed in production. Lead forms: used only when
# both keys are set. Cloudflare's test keys work locally.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Tracking (only after the visitor accepts the cookie banner; empty = off, no banner).
# META_CAPI_TOKEN enables server-side Conversions API for Lead and Purchase.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_CAPI_TEST_CODE=
META_GRAPH_VERSION=v21.0
GA4_MEASUREMENT_ID=

# Bank transfer details (settings defaults; editable in admin)
BANK_ACCOUNT_NAME="Destination Pakistan"
BANK_NAME="Standard Chartered Bank"
BANK_IBAN=PK91SCBL0000001702859701
BANK_SWIFT=SCBLPKKX
BANK_COUNTRY=Pakistan
BANK_ADDRESS="Main Building, Floor 3, I.I. Chundrigar Road, Karachi 74200"

# Exact location pin, sent only after a booking is confirmed
BOOKING_MAP_PIN_URL=

# Weather alerts (milestone 10f): venue coordinates, private, used only to
# fetch the Open-Meteo forecast. Editable in admin settings.
WEATHER_LAT=
WEATHER_LNG=
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Security hardening (config/security.php, config/csp.php, docs/SECURITY.md).
# CSP_REPORT_ONLY=true sends the policy as report-only (staging trial).
CSP_ENABLED=true
CSP_REPORT_ONLY=false
CSP_REPORTING=true
HSTS_ENABLED=true
HSTS_PRELOAD=true
ADMIN_IDLE_MINUTES=30
ADMIN_FAILED_LOGIN_ALERT_THRESHOLD=5

# Backups (milestone 12, docs/DEPLOY.md). Encrypted zip of the database and
# server-only files, daily, kept 30 days on the "backups" disk.
# BACKUP_ARCHIVE_PASSWORD is required in staging and production: without it
# the archive is not encrypted. Keep it in the password manager.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
# Optional: another folder for the archives (default storage/app/backups).
BACKUP_DISK_ROOT=
# Optional: folder holding mysqldump when it is not on the cron user's PATH.
DB_DUMP_BINARY_PATH=
# Production: LOG_STACK=daily keeps LOG_DAILY_DAYS days of log files.
LOG_DAILY_DAYS=14
# Optional: replaces the trusted Cloudflare ranges in config/security.php.
TRUSTED_PROXIES=
